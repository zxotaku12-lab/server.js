# ---- Quest Bot config ----

# Bot token (Developer Portal -> Bot -> Reset Token)
# Dashboard se bhi paste kar sakte ho — ye file optional hai.
DISCORD_TOKEN=

# Optional: is server me commands TURANT register hongi (global me ~1 ghanta lagta hai)
GUILD_ID=

# Optional: Application ID — bot offline ho tab bhi dashboard pe invite link banane ke liye
# (Developer Portal -> General Information -> Application ID)
CLIENT_ID=

# Dashboard ka port (Render khud set karta hai)
PORT=3000

# Optional: dashboard ko protect karna ho to password set karo
DASHBOARD_PASSWORD=
