# Gogeta's Pet — environment template
# Copy to .env, then fill in what you need. Everything here is read through
# env_loader.load_clean_dotenv(), which tolerates decorative section headings.
# Never commit the real .env.

# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
# Bot token from the Discord Developer Portal. Required — check_deploy.py fails
# without it. Portal: Application → Bot → Reset Token. Kabhi share/commit mat karo.
TOKEN=

# The server where `python scripts/sync_commands.py` should push commands
# instantly (guild-scoped sync). Optional — khaali chhodo to global sync hoga.
# Developer Mode on karke server name pe right-click → Copy Server ID.
DISCORD_GUILD_ID=

# Numeric Discord user ID that owns the bot (unlocks owner-only commands).
GOGETAS_PET_OWNER_ID=

# The "dad"/creator persona target + the extra owner bypass for moderation.
CREATOR_USER_ID=
DEVELOPER_USER_IDS=
DEVELOPER_BYPASS_ID=

# Optional: shown in the console banner and in embed footers.
SUPPORT_URL=
SERVER_VANITY_URL=

# Role granted the staff bonus in invite/activity flows (numeric ID).
BONUS_STAFF_ROLE_ID=

# React to this user's mentions (0/unset = off).
MENTION_REACT_USER_ID=

# ---------------------------------------------------------------------------
# EMOJI REGISTRY
# ---------------------------------------------------------------------------
# Guild the bot copies custom emoji from by its exact names.
EMOJI_SOURCE_GUILD_ID=
EMOJI_SOURCE_FALLBACK=1
EMOJI_SOURCE_REFRESH_SECONDS=3600
Q_ARROW_EMOJI=

# ---------------------------------------------------------------------------
# AI ROUTER (MultiAI / Gogeta's Pet / TicketAI)
# ---------------------------------------------------------------------------
AI_ENABLED=true
AI_MENTION_ONLY=true

# Provider priority; missing keys/cooling-down providers are skipped.
AI_PROVIDER_ORDER=openai,groq,gemini,cerebras,openrouter,together,mistral,deepinfra,fireworks,cloudflare,github,huggingface,nvidia,sambanova

# At least one provider key makes AI replies work. Each provider can hold
# several comma-separated keys for rotation.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
TOGETHER_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_BASE_URL=
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=
DEEPINFRA_BASE_URL=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
FIREWORKS_BASE_URL=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_MODEL=
GITHUB_TOKEN=
GITHUB_MODEL=
HF_TOKEN=

# Routing / latency tuning (defaults shown).
AI_MAX_INPUT=1200
AI_CHAT_MAX_INPUT=1200
AI_MAX_OUTPUT=90
AI_TIMEOUT=35
AI_ATTEMPT_TIMEOUT=14
AI_HEDGE_DELAY=3.0
AI_TOTAL_TIMEOUT=30
AI_MAX_PARALLEL=3
AI_KEYS_PER_CALL=3
AI_KEY_COOLDOWN_SECONDS=60
AI_KEY_FAILURE_THRESHOLD=2
AI_REASONING_EFFORT=none
AI_REASONING_HEADROOM=256
AI_TEMPERATURE=0.95
AI_TOP_P=0.9
AI_HISTORY_TURNS=8
AI_HISTORY_TTL=1800

# GIF reactions in chat (unset = GIF replies disabled).
GIPHY_API_KEY=

# ---------------------------------------------------------------------------
# TICKET AI
# ---------------------------------------------------------------------------
TICKET_AI_ENABLED=true
TICKET_AI_KNOWLEDGE=knowledge/ticket_ai.md
TICKET_AI_STAFF_ROLE_ID=
TICKET_AI_CONTEXT_MESSAGES=14
TICKET_AI_HISTORY_TURN_HINTS=8
TICKET_AI_MAX_OUTPUT=900
TICKET_AI_TEMPERATURE=0.40
TICKET_AI_TOP_P=0.90
TICKET_AI_REASONING_EFFORT=medium
TICKET_AI_COOLDOWN=0.15
TICKET_AI_PENDING_ACTION_TTL=120

# Channel that hosts the persistent ticket panel.
TICKET_PANEL_CHANNEL_ID=

# ---------------------------------------------------------------------------
# QUESTBOT / INVITE SUPPORT
# ---------------------------------------------------------------------------
QUESTBOT_ID=
QUEST_ACCESS_REMINDER_ENABLED=true
QUEST_ACCESS_COOLDOWN=86400
QUEST_ACCESS_CHANNEL_ID=
QUEST_TRIAL_CHANNEL_ID=

# /invites check card uses another bot's command (default: &is).
INVITE_BOT_ID=
INVITE_CHECK_COMMAND=&is
INVITE_CHECK_TIMEOUT=12

# ---------------------------------------------------------------------------
# MISC
# ---------------------------------------------------------------------------
GHOSTPING_DELAY=1
SERVER_LOG_DB=cogs/server_logs.db
GUILD_KNOWLEDGE_DIR=knowledge/servers
GUILD_KNOWLEDGE_MAX_BYTES=6000

# Interactive discord.py Components V2 demo cog — off unless explicitly enabled.
ENABLE_CV2_TEST_COG=false
